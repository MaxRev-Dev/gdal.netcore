include RID.opt
include ../shared/GdalCore.opt
include ../shared/bundle/base.opt

ifeq ($(APP_RUN),)
TEST_TARGET=$(TEST_DIR)
CMD_TYPE=dotnet test --tl:off
else
TEST_TARGET=$(TEST_DIR_APP)
CMD_TYPE=dotnet run --tl:off
endif

MISSING_PACKAGES=MaxRev.Gdal.MacosRuntime.Minimal MaxRev.Gdal.WindowsRuntime.Minimal MaxRev.Gdal.Universal
CLI_TEST_DIR=$(ROOTDIR_)/tests/MaxRev.GdalCore.Tests.CLI
CLI_RID=linux-$(BUILD_ARCH)

all: test

###	Testing linux libraries (from nuget build output)
test-restore:
	-@for v in $(MISSING_PACKAGES); do \
		cd "$(TEST_DIR)/../MaxRev.Gdal.Core.Tests.AzureFunctions" && dotnet remove package $$v &> /dev/null; \
		cd "$(TEST_DIR)/../MaxRev.Gdal.Core.Tests" && dotnet remove package $$v &> /dev/null;  \
		cd "$(TEST_DIR)/../MaxRev.Gdal.Core.Tests.XUnit" && dotnet remove package $$v &> /dev/null;  \
	done;
	-cd $(TEST_TARGET) && \
		dotnet restore --ignore-failed-sources

test-update:
	-cd $(TEST_DIR_APP) && \
		dotnet add package MaxRev.Gdal.Core -v "$(GDAL_VERSION).$(PACKAGE_BUILD_NUMBER)" -s $(NUGET_)
	-cd $(TEST_TARGET_AZ) && \
		dotnet add package MaxRev.Gdal.Core -v "$(GDAL_VERSION).$(PACKAGE_BUILD_NUMBER)" -s $(NUGET_)
	-cd $(TEST_TARGET) && \
		dotnet add package MaxRev.Gdal.LinuxRuntime.Minimal.$(BUILD_ARCH) -v "$(GDAL_VERSION).$(PACKAGE_BUILD_NUMBER)" -s $(NUGET_)
	-cd $(TEST_TARGET) && \
		dotnet add package MaxRev.Gdal.Core -v "$(GDAL_VERSION).$(PACKAGE_BUILD_NUMBER)" -s $(NUGET_)

test-only: test-restore
	cd $(TEST_TARGET) && \
		$(CMD_TYPE) --no-restore $(TEST_DIR)/*.csproj

test-cli:
	rm -rf $(CLI_TEST_DIR)/bin $(CLI_TEST_DIR)/obj
	cd $(CLI_TEST_DIR) && \
		dotnet add package MaxRev.Gdal.CLI.$(CLI_RID) -v "$(GDAL_VERSION).$(PACKAGE_BUILD_NUMBER)" -s $(NUGET_) --no-restore
	cd $(CLI_TEST_DIR) && \
		dotnet add package MaxRev.Gdal.LinuxRuntime.Minimal.$(BUILD_ARCH) -v "$(GDAL_VERSION).$(PACKAGE_BUILD_NUMBER)" -s $(NUGET_) --no-restore
	cd $(CLI_TEST_DIR) && \
		dotnet restore --ignore-failed-sources -s $(NUGET_)
	cd $(CLI_TEST_DIR) && \
		dotnet build -c Release --no-restore
	cd $(CLI_TEST_DIR) && \
		dotnet run -c Release --no-build
	cd $(CLI_TEST_DIR) && \
		cli_tool=$$(find ./bin/Release -type f -name gdalinfo | head -n 1) && \
		cli_tool_dir=$$(dirname "$$cli_tool") && \
		lib_dir="$${cli_tool_dir}/runtimes/$(CLI_RID)/native" && \
		GDAL_DATA="$${cli_tool_dir}/runtimes/any/native/gdal-data" \
		PROJ_LIB="$${lib_dir}/maxrev.gdal.core.libshared" \
		LD_LIBRARY_PATH="$${lib_dir}:$${LD_LIBRARY_PATH}" \
		"$$cli_tool" --version

test: test-restore test-update test-only test-cli
	@exit 0
