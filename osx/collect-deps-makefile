include RID.opt
include ../shared/GdalCore.opt

ifeq ($(RID),)
RID=osx-arm64
endif

BUILD_BASE_LIB=$(GDAL_BUILD)/lib
SHELL=/bin/bash
# Prefer persisted bindings in gdal-build (survives cache restore)
# Fall back to cmake-temp for fresh builds where gdal-build/swig doesn't exist yet
ifneq ($(wildcard $(GDAL_BUILD)/swig/csharp/.),)
BINDINGS_SOURCE=$(GDAL_BUILD)/swig/csharp
else
BINDINGS_SOURCE=$(BUILD_ROOT)/gdal-cmake-temp/swig/csharp
endif

# codesining requires paid certificate, so we will use ad-hoc signing to avoid issues with macOS Gatekeeper
CODESIGN_IDENTITY?=-

# output helper
define \n


endef

all: build

OUTPUT = $(PACKAGE_BUILD_ROOT)/runtimes/$(RID)/native
TOOLS_OUTPUT = $(PACKAGE_BUILD_ROOT)/tools/$(RID)
BUILD_BASE = $(BASE)/bindings
WRAP_TARGETS = $(wildcard $(BINDINGS_SOURCE)/lib*.dylib)

echo-targets: $(WRAP_TARGETS)
	WRAP_TARGETS_1=$(addprefix  -x , $(notdir $(WRAP_TARGETS)))
	@echo $(WRAP_TARGETS_1)

.PHONY: force
$(WRAP_TARGETS): force
	@echo $(@F)


build: linkall
	@echo "Bindings and drivers are ready to packaging!"
	$(MAKE) -f gdal-makefile formats-output

linkall: initdirs copy-projdb collect-bindings copy-deps copy-tools
	@echo "Libraries patched successfully"

clean:
	(cd $(BUILD_BASE) && rm -f ${CSHARP_MODULES} *.$(OBJ_EXT) *.config *.dll *.mdb *.exe)
	(cd $(PWD) && rm -f ${CSHARP_MODULES} *.$(OBJ_EXT) *.config *.dll *.mdb *.exe)

cleanpackages:
	@if [ -d "$(NUGET_DIR)" ]; then rm -rf "$(NUGET_DIR)"; fi;

initdirs:
	rm -rvf $(OUTPUT)/*.*
	mkdir -p $(OUTPUT)
	mkdir -p $(NUGET_DIR)
	rm -rvf $(TOOLS_OUTPUT)/*
	mkdir -p $(TOOLS_OUTPUT)

collect-bindings:
# copy generatated c# sources to project directory
# to make them available for windows package build
	@if [ ! -d "$(BUILD_BASE)" ]; then mkdir "$(BUILD_BASE)"; fi;
	mkdir -p $(BUILD_BASE)/const/ && cp -fRL $(BINDINGS_SOURCE)/const/*.cs  $(BUILD_BASE)/const/
	mkdir -p $(BUILD_BASE)/gdal/ && cp -fRL $(BINDINGS_SOURCE)/gdal/*.cs $(BUILD_BASE)/gdal/
	mkdir -p $(BUILD_BASE)/osr/ && cp -fRL $(BINDINGS_SOURCE)/osr/*.cs $(BUILD_BASE)/osr/
	mkdir -p $(BUILD_BASE)/ogr/ && cp -fRL $(BINDINGS_SOURCE)/ogr/*.cs $(BUILD_BASE)/ogr/

copy-deps:
#	including all deps installed in this repo
#	and some external dependencies
#	1. copy gdal.dylib.XX
#	2. get deps inlcuding PROJ and LD_LIBRARY_PATH
#	3. copy to output
#	NOTE: we intentionally do NOT also ship a libgdal.<major>.dylib
#	alongside the fully versioned libgdal.<major>.<minor>.<patch>.dylib.
#	NuGet does not preserve symlinks, so a "symlink" copy becomes a second
#	full ~30+MB binary in the package. Instead every consumer (wrap libs via
#	dylibbundler, CLI tools via copy-tools below) is patched to reference the
#	single real, fully versioned file name.
	cp -rfL $(BINDINGS_SOURCE)/*.dylib $(OUTPUT)/

	dylibbundler -b  \
		$(addprefix  -x , $(addprefix $(OUTPUT)/,$(notdir $(WRAP_TARGETS)))) \
		-s ${VCPKG_INSTALLED_DYNAMIC}/lib \
		-s $(BUILD_BASE_LIB) \
		-s $(PROJ_BUILD)/lib \
		-s $(HDF_BUILD)/lib \
		-of \
		-cd -d $(OUTPUT)/ -p "@loader_path/"
	@echo "Removing duplicate RPATH entries..."
	@for lib in $(OUTPUT)/*.dylib; do \
		if [ -f "$$lib" ]; then \
			rpaths=$$(otool -l "$$lib" | grep -A 2 "cmd LC_RPATH" | grep "path " | awk '{print $$2}' | sort | uniq -d); \
			for rpath in $$rpaths; do \
				echo "Removing duplicate RPATH $$rpath from $$(basename $$lib)"; \
				install_name_tool -delete_rpath "$$rpath" "$$lib" 2>/dev/null || true; \
			done; \
			codesign --remove-signature "$$lib" 2>/dev/null || true; \
			codesign --force --sign "$(CODESIGN_IDENTITY)" "$$lib" 2>/dev/null || true; \
		fi; \
	done

copy-tools:
#	Copy the raw CLI tools, then rewrite every @rpath/libNAME.dylib load
#	command to point at the real, fully versioned file name we actually
#	ship in $(OUTPUT) (e.g. @rpath/libproj.25.dylib -> @rpath/libproj.25.9.x.y.dylib).
#	Tools are built against short "API version" names (libNAME.MAJOR.dylib)
#	but dylibbundler only patches the wrap/driver dylibs it was given via -x,
#	not these CLI executables, so without this step any tool that links a
#	dependency other than libgdal (e.g. gdalsrsinfo -> libproj) fails to
#	load at runtime because we never ship the short-name file.
	cp -rfL $(GDAL_BUILD)/bin/* $(TOOLS_OUTPUT)/
	@for tool in $(TOOLS_OUTPUT)/*; do \
		if [ -f "$$tool" ] && file "$$tool" | grep -q "Mach-O"; then \
			for ref in $$(otool -L "$$tool" | tail -n +2 | awk '{print $$1}' | grep '^@rpath/'); do \
				libname=$$(basename "$$ref"); \
				if [ -f "$(OUTPUT)/$$libname" ]; then \
					continue; \
				fi; \
				base_no_ext=$$(echo "$$libname" | sed -E 's/\.dylib$$//'); \
				real=$$(ls "$(OUTPUT)/$$base_no_ext".*.dylib 2>/dev/null | sort -V | tail -n 1); \
				if [ -z "$$real" ]; then \
					echo "ERROR: $$tool references $$ref but no matching library is shipped in $(OUTPUT)"; \
					exit 1; \
				fi; \
				real_name=$$(basename "$$real"); \
				echo "Patching $$(basename $$tool): $$ref -> @rpath/$$real_name"; \
				install_name_tool -change "$$ref" "@rpath/$$real_name" "$$tool"; \
			done; \
			codesign --remove-signature "$$tool" 2>/dev/null || true; \
			codesign --force --sign "$(CODESIGN_IDENTITY)" "$$tool" || exit 1; \
		fi; \
	done
	$(MAKE) -f collect-deps-makefile check-tool-deps

# Build-time guard: every @rpath reference a shipped tool makes must resolve
# to a file we actually ship, and every absolute reference must be a system
# library. Fails the build instead of shipping a tool that dyld can't load.
check-tool-deps:
	@status=0; \
	for tool in $(TOOLS_OUTPUT)/*; do \
		if [ -f "$$tool" ] && file "$$tool" | grep -q "Mach-O"; then \
			for ref in $$(otool -L "$$tool" | tail -n +2 | awk '{print $$1}'); do \
				case "$$ref" in \
					@rpath/*) \
						libname=$$(basename "$$ref"); \
						if [ ! -f "$(OUTPUT)/$$libname" ]; then \
							echo "ERROR: $$(basename $$tool) references unresolved $$ref"; \
							status=1; \
						fi ;; \
					/usr/lib/*|/System/*) ;; \
					@loader_path/*|@executable_path/*) ;; \
					*) \
						echo "ERROR: $$(basename $$tool) references unexpected absolute path $$ref"; \
						status=1 ;; \
				esac; \
			done; \
		fi; \
	done; \
	if [ "$$status" != "0" ]; then \
		echo "check-tool-deps: one or more packaged tools reference libraries that are not shipped"; \
		exit 1; \
	fi; \
	echo "check-tool-deps: all packaged tool library references resolve"

copy-projdb:
	-mkdir -p $(LIBSHARED)
	cp -rf $(PROJ_BUILD)/share/proj/proj.db $(LIBSHARED)


.EXPORT_ALL_VARIABLES:
PKG_CONFIG_PATH=$$PKG_CONFIG_PATH:$(VCPKG_INSTALLED_DYNAMIC)/lib/pkgconfig
LD_LIBRARY_PATH=$$LD_LIBRARY_PATH:${VCPKG_INSTALLED_DYNAMIC}/lib
DYLD_LIBRARY_PATH=$$DYLD_LIBRARY_PATH:${VCPKG_INSTALLED_DYNAMIC}/lib
